#!/bin/sh
set -eu

for cmd in mysql asterisk; do command -v "$cmd" >/dev/null 2>&1 || { echo "Error: $cmd not found." >&2; exit 127; }; done

case "${1:-}" in
    reboot) q="reboot=Reboot" ;;
    reset)  q="reset=Reset" ;;
    *) echo "Usage: $0 <reboot|reset>" >&2; exit 1 ;;
esac

stty -echo
printf "Password: " >&2
read -r p
stty echo
echo >&2

exts=$(mysql -B -N -e "SELECT extension FROM asterisk.users;" | tr '\n' ' ')

asterisk -rx "pjsip show contacts" | awk -v e="$exts" '
BEGIN { n = split(e, db, " ") }
{
    for (i=1; i<=n; i++) {
        if ($0 ~ "Contact:[[:space:]]+" db[i] "/") {
            split($2, a, /[@:]/)
            print a[3], db[i]
        }
    }
}' | while read -r ip ext; do
    echo "curl -s -k --digest -u \"admin:$p\" \"https://$ip/advanced_update.htm?$q\" # $ext"
done
echo "# Pipe to sh to execute: $0 ${1:-} | sh" >&2
