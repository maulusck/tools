#!/bin/sh
set -eu

APPLY=false
[ "${1:-}" = "--apply" ] && APPLY=true

# Fetch data to a variable first to avoid pipe subshell issues
DATA=$(mysql -B -N -e "SELECT u.extension, s.data FROM asterisk.users u JOIN asterisk.sip s ON u.extension = s.id WHERE s.keyword='secret';")

[ -z "$DATA" ] && echo "No extensions found." && exit 0

echo "$DATA" | while read -r ext current; do
    # Generate 32-char alphanumeric secret safely
    new=$(LC_ALL=C tr -dc 'a-zA-Z0-9' < /dev/urandom | dd bs=32 count=1 2>/dev/null)

    printf "%-8s | %s -> %s\n" "$ext" "$current" "$new"

    if [ "$APPLY" = "true" ]; then
        mysql -e "UPDATE asterisk.sip SET data='$new' WHERE id='$ext' AND keyword='secret'; UPDATE asterisk.ps_auths SET secret='$new' WHERE id='$ext';" 2>/dev/null || true
    fi
done

if [ "$APPLY" = "true" ]; then
    fwconsole reload
else
    echo "Dry run complete. Use --apply to execute."
fi
